#!/usr/bin/env python3
"""qualstack-status — deterministic inventory of a QualStack project folder.

Backs /qualstack:paper-status. One call replaces a couple of dozen globs, greps,
and stat lookups: it prints the config summary, every pipeline artifact with
its state (present / thin / stub / missing), date, and verdict line; the
artifacts that are stale because an input changed after they were written;
the integrity of the evidence trail (files in evidence/raw/ that no log row
names, log rows whose files are missing, coded values with no evidence behind
them); the stage the artifacts imply, and whether that agrees with paper.status
in .qualstack/config.yaml. It never writes anything. Standard library only.

Usage:
  qualstack-status                 # inspect the project folder at or above cwd
  qualstack-status path/to/project
  qualstack-status --json          # machine-readable
"""
from __future__ import annotations

import csv
import datetime as dt
import glob
import json
import re
import sys
from pathlib import Path

STAGES = ["ideate", "model", "design", "collect", "analyze", "write", "submit", "reflect"]
STATUS_STAGE = {
    "ideating": "ideate", "modeling": "model", "designing": "design",
    "collecting": "collect", "analyzing": "analyze", "writing": "write",
    "submitted": "submit", "r-and-r": "submit", "accepted": "submit",
    "archived": "reflect",
}

# (stage, pattern, kind, required). kind: "verdict" pulls the first
# Verdict/Recommendation line; "sections" reports drafted-vs-stub counts;
# "files" counts non-stub files; "log" counts evidence rows. Patterns may list
# alternatives with "|". Only required artifacts count as gaps. Conditional
# requirements (formal model, fieldwork, human subjects) are applied in
# inventory() from the config.
ARTIFACTS = [
    ("ideate", ".qualstack/research-question.md", "verdict", True),
    ("ideate", ".qualstack/idea-shotgun-*.md", "file", False),
    ("ideate", ".qualstack/scope-challenge-*.md", "verdict", False),
    ("model", "lit/pdf/*.pdf", "files", False),
    ("model", "lit/index.md", "file", False),
    ("model", ".qualstack/lit-map.md", "file", True),
    ("model", ".qualstack/theory.md", "file", True),
    ("model", ".qualstack/model.md", "file", True),
    ("model", "code/01-model.R", "file", True),
    ("model", ".qualstack/queries.md", "file", True),
    ("model", ".qualstack/model-review-*.md", "verdict", True),
    ("design", ".qualstack/design.md", "file", True),
    ("design", ".qualstack/case-selection.md", "file", True),
    ("design", ".qualstack/clue-plan.md", "file", True),
    ("design", "data/coding-rules.md", "file", True),
    ("design", ".qualstack/fieldwork-plan.md", "file", False),
    ("design", ".qualstack/interview-guide.md", "file", False),
    ("design", "prereg/prereg.md", "file", False),
    ("collect", "evidence/log.csv", "log", True),
    ("collect", "evidence/raw/**/*", "files", True),
    ("collect", ".qualstack/source-critique-*.md", "file", False),
    ("collect", ".qualstack/chronology-*.md", "files", False),
    ("collect", "data/case-data.csv", "file", True),
    ("collect", "data/coding-log.csv", "file", True),
    ("analyze", ".qualstack/process-trace-*.md", "files", True),
    ("analyze", "code/04-update.R", "file", True),
    ("analyze", "output/tables/queries.csv", "file", True),
    ("analyze", ".qualstack/robustness-*.md", "verdict", True),
    ("analyze", ".qualstack/evidence-audit-*.md", "verdict", True),
    ("analyze", "output/figures/*.pdf|output/figures/*.png", "files", True),
    ("write", "paper/sections/*.tex|paper/sections/*.qmd", "sections", True),
    ("write", ".qualstack/review-cache/*.md", "verdict", True),
    ("write", ".qualstack/title-shotgun-*.md", "file", False),
    ("submit", ".qualstack/journal-fit-*.md", "file", True),
    ("submit", "submission/submission-checklist-*.md", "file", True),
    ("submit", "submission/cover-letter.md", "file", True),
    ("submit", "submission/response-to-reviewers/*-response.md", "file", False),
    ("reflect", ".qualstack/retro.md", "file", True),
    ("reflect", "transparency-manifest.txt", "file", True),
]
FORMAL_ONLY = {"code/01-model.R", "code/04-update.R", "output/tables/queries.csv"}

# An artifact is stale when any of these inputs is newer than the newest
# matching artifact file.
STALE_INPUTS = {
    ".qualstack/lit-map.md": ["lit/index.md"],
    ".qualstack/theory.md": [".qualstack/lit-map.md"],
    ".qualstack/model.md": [".qualstack/theory.md"],
    ".qualstack/queries.md": [".qualstack/model.md", "code/01-model.R"],
    ".qualstack/model-review-*.md": [".qualstack/theory.md", ".qualstack/model.md", "code/01-model.R",
                                     ".qualstack/queries.md"],
    ".qualstack/design.md": [".qualstack/model-review-*.md", ".qualstack/queries.md"],
    ".qualstack/case-selection.md": ["code/01-model.R", ".qualstack/queries.md", "data/raw/**/*"],
    ".qualstack/clue-plan.md": ["code/01-model.R", ".qualstack/queries.md", ".qualstack/case-selection.md"],
    "data/coding-rules.md": [".qualstack/model.md", "code/01-model.R"],
    "prereg/prereg.md": [".qualstack/queries.md", ".qualstack/clue-plan.md", "data/coding-rules.md",
                         "code/01-model.R", ".qualstack/case-selection.md"],
    "data/case-data.csv": ["data/coding-rules.md"],
    ".qualstack/process-trace-*.md": ["evidence/log.csv", "data/case-data.csv"],
    "output/tables/queries.csv": ["code/01-model.R", "code/03-data.R", "code/04-update.R",
                                  "data/case-data.csv"],
    ".qualstack/robustness-*.md": ["code/01-model.R", "code/04-update.R", "code/05-robustness.R",
                                   "data/case-data.csv"],
    ".qualstack/evidence-audit-*.md": ["paper/sections/*", "evidence/log.csv", "data/case-data.csv",
                                       "data/coding-log.csv", "output/tables/queries.csv"],
    ".qualstack/review-cache/*.md": ["paper/sections/*"],
    ".qualstack/journal-fit-*.md": ["paper/sections/abstract.*"],
    ".qualstack/title-shotgun-*.md": ["paper/sections/abstract.*"],
    "submission/cover-letter.md": [".qualstack/journal-fit-*.md", "paper/sections/abstract.*"],
}

STUB_MARKER = "writes here"
THIN_CHARS = 250          # non-comment chars below which a real artifact is suspicious
SECTION_CHARS = 1000      # a drafted manuscript section is longer than this


def find_project(start: Path):
    p = start.resolve()
    for c in [p, *p.parents]:
        if (c / ".qualstack").is_dir():
            return c
    return None


def read_config(project: Path) -> dict:
    """Minimal reader for the few config.yaml keys status needs (no PyYAML)."""
    cfg = {"title": "", "short_name": "", "format": "", "status": "", "type": "", "prereg": "",
           "prereg_url": "", "fieldwork": "", "human_subjects": "", "statement": "",
           "primary_query": "", "formal": "", "ai_processing": "", "journals": [],
           "writing_style": ""}
    try:
        lines = (project / ".qualstack" / "config.yaml").read_text().splitlines()
    except OSError:
        return cfg
    section = None
    for raw in lines:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip())
        line = raw.split(" #")[0].strip()
        if indent == 0:
            section = line.rstrip(":") if line.endswith(":") else None
            continue
        key, _, value = line.partition(":")
        key, value = key.strip().lstrip("- ").strip(), value.strip().strip("\"'")
        if section == "paper" and key in ("title", "short_name", "format", "status"):
            cfg[key] = value
        elif section == "design" and key in ("type", "prereg", "prereg_url", "fieldwork", "human_subjects"):
            cfg[key] = value
        elif section == "model" and key in ("statement", "primary_query", "formal"):
            cfg[key] = value
        elif section == "privacy" and key == "ai_processing":
            cfg[key] = value
        elif section == "voice" and key == "writing_style":
            cfg[key] = value
        elif section == "target_journals" and key == "name" and value:
            cfg["journals"].append(value)
    return cfg


def truthy(value: str) -> bool:
    return str(value).strip().lower() in ("true", "yes", "1")


def _repetitive(lines) -> bool:
    """Placeholder text is often one line or sentence pasted several times."""
    sentences = [s.strip() for s in re.split(r"(?<=[.!?])\s+", " ".join(lines)) if s.strip()]
    for units in (lines, sentences):
        if len(units) >= 4 and len(set(units)) / len(units) <= 0.5:
            return True
    return False


def content_state(path: Path, min_chars: int = THIN_CHARS) -> str:
    """'stub' (template placeholder or empty), 'thin' (too small or too
    repetitive to be a real artifact of its kind; open it before trusting it),
    or 'present'."""
    try:
        text = path.read_text(errors="ignore")
    except OSError:
        return "stub"
    if STUB_MARKER in text:
        return "stub"
    suffix = path.suffix.lower()
    if suffix in (".tex", ".qmd", ".md", ".r", ".txt"):
        body = []
        for line in text.splitlines():
            s = line.strip()
            if not s or s.startswith(("%", "<!--", "#")) and suffix != ".md":
                continue
            if suffix == ".r" and (s.startswith("#") or s.startswith("library(")):
                continue
            body.append(s)
        n = len(" ".join(body))
        if n < 40:
            return "stub"
        return "thin" if n < min_chars or _repetitive(body) else "present"
    if suffix == ".csv":
        rows = [l for l in text.splitlines() if l.strip()]
        return "stub" if len(rows) <= 1 else "present"
    size = path.stat().st_size
    return "stub" if size == 0 else "thin" if size < min_chars else "present"


def is_stub(path: Path) -> bool:
    return content_state(path) != "present"


def verdict_line(path: Path) -> str:
    """First Verdict/Recommendation line; if that line is only a heading, the line after it."""
    def clean(s):
        return re.sub(r"\s+", " ", re.sub(r"[*#_`>\-\[\]]+", " ", s)).strip()
    try:
        lines = [l for l in path.read_text(errors="ignore").splitlines() if l.strip()]
    except OSError:
        return ""
    for i, line in enumerate(lines):
        if re.search(r"\b(verdict|recommendation)\b", line, re.I):
            text = clean(line)
            if re.fullmatch(r"(?i)(the )?(verdict|recommendation):?", text) and i + 1 < len(lines):
                text = f"{text.rstrip(':')}: {clean(lines[i + 1])}"
            return text[:90]
    return ""


def mtime(path: Path) -> float:
    try:
        return path.stat().st_mtime
    except OSError:
        return 0.0


def day(ts: float) -> str:
    return dt.date.fromtimestamp(ts).isoformat() if ts else ""


def matches(project: Path, pattern: str):
    hits = [Path(p) for alt in pattern.split("|")
            for p in glob.glob(str(project / alt), recursive=True)]
    return sorted((h for h in hits if h.is_file() and h.name != ".gitkeep"), key=mtime)


def read_csv(path: Path):
    try:
        with path.open(newline="", encoding="utf-8-sig") as fh:
            reader = csv.DictReader(fh)
            return list(reader.fieldnames or []), list(reader)
    except (OSError, csv.Error, UnicodeDecodeError):
        return [], []


def inventory(project: Path, cfg: dict):
    rows, present_by_stage = [], {s: False for s in STAGES}
    formal = cfg.get("formal", "").lower() != "false"
    needs_fieldwork = truthy(cfg.get("fieldwork")) or truthy(cfg.get("human_subjects"))
    for stage, pattern, kind, required in ARTIFACTS:
        if pattern in FORMAL_ONLY and not formal:
            required = False
        if pattern == ".qualstack/fieldwork-plan.md" and needs_fieldwork:
            required = True
        if pattern == ".qualstack/interview-guide.md" and truthy(cfg.get("human_subjects")):
            required = True
        files = matches(project, pattern)
        row = {"stage": stage, "artifact": pattern, "required": required,
               "state": "missing" if required else "optional", "date": "", "note": ""}
        if files:
            newest = files[-1]
            row["date"] = day(mtime(newest))
            if kind == "sections":
                drafted = [f.stem for f in files if content_state(f, SECTION_CHARS) == "present"]
                stubs = [f.stem for f in files if content_state(f, SECTION_CHARS) != "present"]
                row["state"] = f"{len(drafted)}/{len(files)}"
                row["note"] = (f"drafted: {', '.join(drafted) or 'none'}"
                               + (f"; stub or thin: {', '.join(stubs)}" if stubs else ""))
                if drafted:
                    present_by_stage[stage] = True
                else:
                    row["state"] = "stub"
            elif kind == "files":
                real = [f for f in files if not is_stub(f)] if pattern != "evidence/raw/**/*" else files
                row["state"] = f"{len(real)} file{'s' if len(real) != 1 else ''}" if real else "stub"
                if real:
                    present_by_stage[stage] = True
            elif kind == "log":
                _, log_rows = read_csv(newest)
                ids = [r.get("id", "").strip() for r in log_rows if (r.get("id") or "").strip()]
                row["state"] = f"{len(ids)} item{'s' if len(ids) != 1 else ''}" if ids else "stub"
                if ids:
                    present_by_stage[stage] = True
            else:
                state = content_state(newest)
                row["state"] = state
                if state == "present":
                    present_by_stage[stage] = True
                    if kind == "verdict":
                        row["note"] = verdict_line(newest)
                elif state == "thin":
                    row["note"] = "too small or repetitive to be a real artifact; open it before trusting it"
                if len(files) > 1:
                    row["note"] = (row["note"] + f" ({len(files)} files; newest shown)").strip()
        rows.append(row)
    return rows, present_by_stage


def stale_artifacts(project: Path):
    out = []
    for pattern, inputs in STALE_INPUTS.items():
        files = [f for f in matches(project, pattern) if content_state(f) != "stub"]
        if not files:
            continue
        newest = files[-1]
        for inp in inputs:
            for f in matches(project, inp):
                if f == newest:
                    continue
                if content_state(f) != "stub" and mtime(f) > mtime(newest) + 1:
                    out.append({"verdict": str(newest.relative_to(project)), "verdict_date": day(mtime(newest)),
                                "input": str(f.relative_to(project)), "input_date": day(mtime(f))})
                    break
    return out


def evidence_integrity(project: Path):
    """The evidence trail: every raw file logged, every logged file present,
    every coded value backed by a coding-log row."""
    out = {"log_items": 0, "unlogged": [], "missing_files": [], "duplicate_ids": [],
           "restricted_paths": [], "cases": 0, "nodes": [], "na_share": {},
           "coded_without_evidence": 0, "coding_log_rows": 0}
    header, rows = read_csv(project / "evidence" / "log.csv")
    referenced, seen = set(), set()
    for r in rows:
        eid = (r.get("id") or "").strip()
        if not eid:
            continue
        out["log_items"] += 1
        if eid in seen:
            out["duplicate_ids"].append(eid)
        seen.add(eid)
        for f in (r.get("file") or "").split(";"):
            f = f.strip().strip("/")
            if not f:
                continue
            if f.split("/")[0] == "restricted":
                out["restricted_paths"].append(eid)
                continue
            referenced.add(f)
            if not (project / f).exists():
                out["missing_files"].append(f"{eid}: {f}")
    raw = project / "evidence" / "raw"
    if raw.is_dir():
        for p in sorted(raw.rglob("*")):
            if not p.is_file() or p.name == ".gitkeep":
                continue
            rel = p.relative_to(project).as_posix()
            if rel in referenced or any(rel.startswith(r + "/") for r in referenced):
                continue
            out["unlogged"].append(rel)

    cheader, crow = read_csv(project / "data" / "case-data.csv")
    if cheader:
        case_col = cheader[0]
        nodes = [h for h in cheader if h != case_col]
        out["cases"], out["nodes"] = len(crow), nodes
        for n in nodes:
            vals = [(r.get(n) or "").strip() for r in crow]
            na = sum(1 for v in vals if v.upper() in ("", "NA"))
            out["na_share"][n] = round(na / len(vals), 2) if vals else 0.0
        _, lrows = read_csv(project / "data" / "coding-log.csv")
        out["coding_log_rows"] = len(lrows)
        backed = {((r.get("case") or "").strip(), (r.get("node") or "").strip())
                  for r in lrows if (r.get("evidence_ids") or "").strip()}
        for r in crow:
            case = (r.get(case_col) or "").strip()
            for n in nodes:
                v = (r.get(n) or "").strip()
                if v.upper() not in ("", "NA") and (case, n) not in backed:
                    out["coded_without_evidence"] += 1
    return out


def derived_stage(present_by_stage):
    stage = None
    for s in STAGES:
        if present_by_stage[s]:
            stage = s
    return stage or "ideate"


def gaps_before(rows, stage):
    """Missing artifacts in stages up to and including the derived stage."""
    upto = STAGES[: STAGES.index(stage) + 1]
    return [f"{r['stage']}: {r['artifact']}" for r in rows
            if r["required"] and r["stage"] in upto and r["state"] in ("missing", "stub", "thin")]


def main(argv=None):
    args = [a for a in (argv or sys.argv[1:])]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    start = Path(args[0]) if args else Path.cwd()
    project = find_project(start)
    if project is None:
        print(f"No .qualstack/ found at or above {start.resolve()}; run /qualstack:qualstack-init first.",
              file=sys.stderr)
        return 1
    cfg = read_config(project)
    rows, present = inventory(project, cfg)
    stale = stale_artifacts(project)
    pdfs = [f for f in matches(project, "lit/pdf/*.pdf") if content_state(f) == "present"]
    index = matches(project, "lit/index.md")
    if pdfs and (not index or mtime(pdfs[-1]) > mtime(index[-1]) + 1):
        stale.append({"verdict": "lit/index.md", "verdict_date": day(mtime(index[-1])) if index else "missing",
                      "input": f"lit/pdf/ ({len(pdfs)} PDF{'s' if len(pdfs) != 1 else ''})",
                      "input_date": day(mtime(pdfs[-1])),
                      "note": f"{len(pdfs)} PDF{'s' if len(pdfs) != 1 else ''} in lit/pdf/ newer than the index"
                              f"{'' if index else ' (no index yet)'}: not ingested, run /qualstack:pdf-ingest",
                      "kind": "unconverted-pdfs"})
    integrity = evidence_integrity(project)
    stage = derived_stage(present)
    cfg_stage = STATUS_STAGE.get(cfg["status"], "")
    gaps = gaps_before(rows, stage)
    result = {
        "project": str(project), "config": cfg, "artifacts": rows, "stale": stale,
        "evidence": integrity, "derived_stage": stage, "config_stage": cfg_stage,
        "status_matches": (cfg_stage == stage) if cfg_stage else None, "gaps": gaps,
    }
    if as_json:
        print(json.dumps(result, indent=2))
        return 0

    name = cfg["title"] or cfg["short_name"] or project.name
    print(f"QualStack status: {name}")
    print(f"  folder {project}")
    print(f"  config: status={cfg['status'] or '?'} (stage {cfg_stage or '?'}) · format={cfg['format'] or '?'} "
          f"· design={cfg['type'] or '?'} · prereg={'registered' if cfg['prereg_url'] else cfg['prereg'] or 'false'} "
          f"· fieldwork={cfg['fieldwork'] or 'false'} · human_subjects={cfg['human_subjects'] or 'false'}")
    print(f"  model: {cfg['statement'] or '(no statement in config)'} · primary query: "
          f"{cfg['primary_query'] or '(none)'} · formal={'false' if cfg['formal'].lower() == 'false' else 'true'}")
    print(f"  privacy.ai_processing={cfg['ai_processing'] or '(not set)'} · journals: "
          f"{', '.join(cfg['journals']) or '(none set)'} · writing_style={cfg['writing_style'] or '(none)'}")
    print()
    print(f"{'STAGE':8} {'ARTIFACT':48} {'STATE':9} {'DATE':11} NOTE   (optional = not required; thin = present but suspiciously small)")
    for r in rows:
        print(f"{r['stage']:8} {r['artifact']:48} {r['state']:9} {r['date']:11} {r['note']}")
    print()
    if stale:
        print("STALE (an input changed after this file was written):")
        for s in stale:
            if s.get("kind") == "unconverted-pdfs":
                print(f"  - {s['note']} (newest PDF {s['input_date']})")
            else:
                print(f"  - {s['verdict']} ({s['verdict_date']}) predates {s['input']} ({s['input_date']})")
    else:
        print("STALE: none")
    print()
    ev = integrity
    print(f"EVIDENCE TRAIL: {ev['log_items']} logged item(s); {len(ev['unlogged'])} file(s) in evidence/raw/ "
          f"with no log row; {len(ev['missing_files'])} log row(s) naming a missing file; "
          f"{len(ev['duplicate_ids'])} duplicate ID(s)")
    for f in ev["unlogged"][:8]:
        print(f"  - unlogged: {f}")
    if len(ev["unlogged"]) > 8:
        print(f"  - ... and {len(ev['unlogged']) - 8} more")
    for f in ev["missing_files"][:8]:
        print(f"  - missing: {f}")
    if ev["duplicate_ids"]:
        print(f"  - duplicate IDs: {', '.join(sorted(set(ev['duplicate_ids'])))}")
    if ev["restricted_paths"]:
        print(f"  - log rows pointing into restricted/ (never readable here): {', '.join(ev['restricted_paths'])}")
    if ev["nodes"]:
        na = ", ".join(f"{n} {int(s * 100)}%" for n, s in ev["na_share"].items())
        print(f"CODED CASES: {ev['cases']} case(s) × {len(ev['nodes'])} node(s); share not observed: {na}; "
              f"{ev['coded_without_evidence']} coded value(s) with no evidence row in data/coding-log.csv")
    print()
    agree = "matches config" if cfg_stage == stage else f"config says {cfg['status'] or '?'} (stage {cfg_stage or '?'}) — MISMATCH"
    print(f"DERIVED STAGE: {stage} — {agree}")
    if gaps:
        print("GAPS UP TO THAT STAGE (earliest gap wins for the next-step recommendation):")
        for g in gaps:
            print(f"  - {g}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
